# Supabase embed backend (see supabase/schema.sql). Copy to .env.local for dev;
# set the same two vars in Vercel -> Settings -> Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Open Analytics (getopen.so) — see docs/analytics.md. Leave the key blank and
# the tracker never loads, so dev and preview builds stay out of the numbers.
# Grab the key from the Open dashboard under Settings -> Installation.
NEXT_PUBLIC_OPEN_TRACKING_KEY=
# Optional. Defaults to https://c.getopen.so; only change it when self-hosting.
NEXT_PUBLIC_OPEN_COLLECTOR=
# Optional. Set to "true" on preview deploys to send traffic as unbilled test
# data that stays out of every chart.
NEXT_PUBLIC_OPEN_TEST_MODE=
