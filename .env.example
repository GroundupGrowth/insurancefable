# Supabase embed backend (see supabase/schema.sql). Copy to .env.local for dev;
# set the same two vars in Vercel -> Settings -> Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Open Analytics (getopen.so) — see docs/analytics.md. All three are optional:
# the site's public oa_pk_ key is compiled in, and Production deploys report
# live while previews and local builds fall back to unbilled test mode.
#
# Only set this to point the site at a different Open property.
NEXT_PUBLIC_OPEN_TRACKING_KEY=
# Only set this when self-hosting the collector. Defaults to https://c.getopen.so.
NEXT_PUBLIC_OPEN_COLLECTOR=
# Force test mode on a Production deploy — useful for a dry run before launch.
NEXT_PUBLIC_OPEN_TEST_MODE=
